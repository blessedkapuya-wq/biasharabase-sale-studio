diff --git a/migrations/0001_licenses.sql b/migrations/0001_licenses.sql
new file mode 100644
index 0000000..b6d990b
--- /dev/null
+++ b/migrations/0001_licenses.sql
@@ -0,0 +1,30 @@
+CREATE TABLE IF NOT EXISTS users (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  uid TEXT NOT NULL UNIQUE,
+  email TEXT NOT NULL,
+  created_at INTEGER NOT NULL DEFAULT (unixepoch())
+);
+
+CREATE TABLE IF NOT EXISTS licenses (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  buyer_email TEXT NOT NULL,
+  buyer_name TEXT NOT NULL DEFAULT '',
+  selar_order_id TEXT NOT NULL UNIQUE,
+  license_key TEXT NOT NULL UNIQUE,
+  amount_paid TEXT NOT NULL DEFAULT '',
+  currency TEXT NOT NULL DEFAULT 'USD',
+  status TEXT NOT NULL DEFAULT 'active',
+  max_devices INTEGER NOT NULL DEFAULT 3,
+  source TEXT NOT NULL DEFAULT 'selar-webhook',
+  created_at INTEGER NOT NULL DEFAULT (unixepoch())
+);
+
+CREATE TABLE IF NOT EXISTS device_activations (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  license_id INTEGER NOT NULL REFERENCES licenses(id) ON DELETE CASCADE,
+  device_id TEXT NOT NULL,
+  user_agent TEXT NOT NULL DEFAULT '',
+  first_seen_at INTEGER NOT NULL DEFAULT (unixepoch()),
+  last_seen_at INTEGER NOT NULL DEFAULT (unixepoch()),
+  UNIQUE (license_id, device_id)
+);
