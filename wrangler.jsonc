{
  "name": "biasharabase-sale-studio",
  "main": "worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_URL": "https://biasharabase-sale-studio.blessedkapuya.workers.dev" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biasharabase-page-studio",
      "database_id": "f791e748-d81e-47b2-8f89-c4152ebde377"
    }
  ]
}
